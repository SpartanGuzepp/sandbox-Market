# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string.
# Local (see README): postgres://sandbox:sandbox@localhost:5432/sandbox_market
# Neon: use the "pooled" connection string from the Neon dashboard.
DATABASE_URL=postgres://sandbox:sandbox@localhost:5432/sandbox_market

# A fixed demo agent API key created by the seed script, so curl examples keep working
# after every reset. Must start with "ak_" and be at least 24 characters. Change it in production.
DEMO_AGENT_KEY=ak_demo_change_me_0000000000000000

# --- Used from Phase 3 on ---
# Admin panel password.
ADMIN_PASSWORD=change-me
# PIN for the simulated customer banking app (/bank) that approves step-up payments.
CUSTOMER_PIN=123456
# Secret used to sign admin and bank sessions (long random string).
SESSION_SECRET=change-me-to-a-long-random-string
# Secret used to sign cart summaries (HMAC) so the leash can verify them.
CART_SIGNING_SECRET=change-me-to-another-long-random-string
# Leave empty for "no leash": every payment is approved.
PAYMENT_AUTHORISER_URL=
# Shared secret used to sign requests sent to the authoriser.
PAYMENT_AUTHORISER_SECRET=
# true = include line items in authorisation requests; false = only what a real card authorisation carries.
SEND_BASKET_DETAILS=false
# Comma-separated list of URLs that receive webhook events.
WEBHOOK_URLS=
# Secret used to sign webhook payloads.
WEBHOOK_SECRET=
